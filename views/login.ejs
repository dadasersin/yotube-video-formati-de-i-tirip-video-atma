<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Giriş - Quantum AI Video Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background: #020617; color: white; font-family: 'Segoe UI', sans-serif; }
        .glass { background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen">
    <div class="glass p-8 rounded-[2rem] w-full max-w-md shadow-2xl">
        <h1 class="text-2xl font-black bg-gradient-to-r from-blue-400 to-emerald-400 bg-clip-text text-transparent mb-8 text-center">QUANTUM SHIELD V3 GİRİŞ</h1>
        <% if (error) { %>
            <div class="bg-red-500/20 border border-red-500 text-red-500 p-3 rounded-xl mb-4 text-sm text-center">
                <%= error %>
            </div>
        <% } %>
        <form action="/login" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold text-gray-500 uppercase mb-2">Kullanıcı Adı</label>
                <input type="text" name="username" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-blue-500/50 transition-all">
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-500 uppercase mb-2">Şifre</label>
                <input type="password" name="password" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-blue-500/50 transition-all">
            </div>
            <button type="submit" class="w-full bg-gradient-to-r from-blue-500 to-emerald-500 text-white font-bold py-3 rounded-xl hover:opacity-90 transition-all">Giriş Yap</button>
        </form>
    </div>
</body>
</html>
