<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Quantum AI Video Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background: #020617; color: white; font-family: 'Segoe UI', sans-serif; }
        .glass { background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); }
        .status-pulse { animation: pulse 2s infinite; }
        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.5; } 100% { opacity: 1; } }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen p-4">
    <div class="glass p-8 rounded-[2rem] w-full max-w-3xl shadow-2xl relative">
        <div class="absolute top-8 right-8">
            <a href="/logout" class="text-[10px] text-gray-500 hover:text-red-400 transition-all uppercase font-bold tracking-widest">ÇIKIŞ YAP</a>
        </div>

        <div class="flex justify-between items-center mb-8">
            <h1 class="text-2xl font-black bg-gradient-to-r from-blue-400 to-emerald-400 bg-clip-text text-transparent">QUANTUM AUTO-UPLOAD</h1>
            <span class="text-xs font-mono border border-emerald-500/50 text-emerald-400 px-3 py-1 rounded-full <%= state.isProcessing ? 'status-pulse' : '' %>">
                <%= state.isProcessing ? 'SİSTEM ÇALIŞIYOR' : 'UYKU MODU' %>
            </span>
        </div>

        <div class="grid grid-cols-3 gap-4 mb-8">
            <div class="bg-white/5 p-4 rounded-2xl border border-white/5 text-center">
                <p class="text-gray-500 text-[10px] uppercase">Günlük Limit / Kalan</p>
                <p class="text-xl font-bold"><%= state.processedToday %> / <%= state.dailyLimit %></p>
            </div>
            <div class="bg-white/5 p-4 rounded-2xl border border-white/5 text-center">
                <p class="text-gray-500 text-[10px] uppercase">Sıradaki Videolar</p>
                <p class="text-xl font-bold"><%= state.queue.length %></p>
            </div>
            <div class="bg-white/5 p-4 rounded-2xl border border-white/5 text-center">
                <p class="text-gray-500 text-[10px] uppercase">Başlangıç Saati</p>
                <p class="text-xl font-bold"><%= state.uploadHour %>:00</p>
            </div>
        </div>

        <div class="bg-white/5 p-6 rounded-2xl border border-white/5 mb-8">
            <h3 class="text-xs font-semibold text-gray-500 uppercase mb-4">Yeni Film Ekle</h3>
            <form action="/add-to-queue" method="POST" enctype="multipart/form-data" class="space-y-4">
                <div>
                    <label class="block text-[10px] text-gray-400 uppercase mb-1 ml-1">Video Başlığı</label>
                    <input type="text" name="title" required placeholder="YouTube'da görünecek başlık"
                           class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2 text-sm focus:outline-none focus:border-blue-500/50 transition-all">
                </div>
                <div class="relative group">
                    <input type="file" name="video" class="hidden" id="fileInput" onchange="updateFileName(this)" required>
                    <label for="fileInput" class="flex flex-col items-center justify-center w-full h-24 border-2 border-dashed border-white/10 rounded-2xl cursor-pointer hover:border-blue-500/50 hover:bg-blue-500/5 transition-all">
                        <span id="fileNameDisplay" class="text-sm text-gray-400">Dosya Seçin</span>
                        <span class="text-[10px] text-gray-600 mt-1">MP4, MOV, AVI</span>
                    </label>
                </div>
                <button type="submit" class="w-full bg-blue-600 text-white font-bold py-3 rounded-xl hover:bg-blue-500 transition-all text-sm">SIRAYA EKLE</button>
            </form>
        </div>

        <div>
            <h3 class="text-xs font-semibold text-gray-500 uppercase mb-4">Bekleyen İşlemler</h3>
            <div class="space-y-2">
                <% if (state.queue.length === 0) { %>
                    <span class="text-gray-600 text-sm">Sıra boş...</span>
                <% } else { %>
                    <% state.queue.forEach((v, index) => { %>
                        <div class="flex items-center justify-between bg-white/5 px-4 py-3 rounded-xl border border-white/5">
                            <div class="flex items-center gap-3">
                                <span class="text-gray-600 text-[10px] font-mono">#<%= index + 1 %></span>
                                <span class="text-sm text-gray-300"><%= v.title %></span>
                            </div>
                            <span class="text-[10px] text-gray-500 italic"><%= v.originalname %></span>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        function updateFileName(input) {
            const fileName = input.files[0] ? input.files[0].name : "Dosya Seçin";
            document.getElementById('fileNameDisplay').textContent = fileName;
        }
    </script>
</body>
</html>
